# Copy to .env (never commit .env). Gemini only: get a free key at
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# Your own database, if the source is not the example (see docker-compose.yml):
# DB_URL=postgresql+psycopg2://user:password@db:5432/name

LLM_MODEL=gemini-3.5-flash-lite
LLM_MODE=live
LLM_DELAY=4
# Optional if Java is not on PATH:
# JAVA_EXE=C:/path/to/jdk-21/bin/java.exe

# Optional course PostgreSQL/Ontop comparison (see root README.md):
POSTGRES_USER=kr
POSTGRES_PASSWORD=
