@prefix dct: <http://purl.org/dc/terms/> .
@prefix food: <https://ul.edu.lb/kr/food#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ul.edu.lb/kr/food> a owl:Ontology ;
    dct:conformsTo <https://www.w3.org/TR/owl2-syntax/> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "FoodScope: USDA food composition knowledge graph" ;
    rdfs:comment "FoodScope extension importing the documented FoodOn ancestor module through catalog-v001.xml; no claim to import full FoodOn semantics." ;
    owl:imports <https://ul.edu.lb/kr/food/foodon-module> ;
    owl:priorVersion <https://ul.edu.lb/kr/food/1.0.0> ;
    owl:versionIRI <https://ul.edu.lb/kr/food/1.1.0> ;
    owl:versionInfo "1.1.0; OWL 2 DL extension; imported asserted FoodOn ancestor module" .

food:CharacterizedFood a owl:Class ;
    rdfs:subClassOf food:Food ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( food:Food [ a owl:Restriction ;
                        owl:onProperty food:hasObservation ;
                        owl:someValuesFrom food:Observation ] ) ] ;
    food:answersCQ "CQ6: foods with a recorded composition observation" .

food:amount a owl:DatatypeProperty ;
    rdfs:domain food:Observation ;
    rdfs:range xsd:decimal ;
    food:answersCQ "CQ3,CQ4" .

food:answersCQ a owl:AnnotationProperty .

food:category a owl:ObjectProperty ;
    rdfs:domain food:Food ;
    rdfs:range food:Category ;
    food:answersCQ "CQ2,CQ5" .

food:name a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    food:answersCQ "CQ1-CQ5" .

food:nutrient a owl:ObjectProperty ;
    rdfs:domain food:Observation ;
    rdfs:range food:Nutrient ;
    food:answersCQ "CQ3,CQ4" .

food:publishedOn a owl:DatatypeProperty ;
    rdfs:domain food:Food ;
    rdfs:range xsd:dateTime ;
    food:answersCQ "CQ5" .

food:sourceId a owl:DatatypeProperty ;
    rdfs:domain food:Food ;
    rdfs:range xsd:string ;
    food:answersCQ "CQ1" .

food:unit a owl:DatatypeProperty ;
    rdfs:domain food:Nutrient ;
    rdfs:range xsd:string ;
    food:answersCQ "CQ3,CQ4" .

food:Category a owl:Class ;
    owl:disjointWith food:Food,
        food:Nutrient,
        food:Observation ;
    food:answersCQ "CQ2,CQ5" .

food:hasObservation a owl:ObjectProperty ;
    rdfs:domain food:Food ;
    rdfs:range food:Observation ;
    owl:inverseOf food:ofFood ;
    food:answersCQ "CQ3,CQ4,CQ6" .

food:ofFood a owl:ObjectProperty ;
    rdfs:domain food:Observation ;
    rdfs:range food:Food ;
    food:answersCQ "CQ3,CQ4" .

food:Nutrient a owl:Class ;
    owl:disjointWith food:Food ;
    food:answersCQ "CQ3,CQ4" .

food:Observation a owl:Class ;
    owl:disjointWith food:Food,
        food:Nutrient ;
    food:answersCQ "CQ3,CQ4,CQ6" .

food:Food a owl:Class ;
    rdfs:subClassOf obo:FOODON_00001002 ;
    food:answersCQ "CQ1-CQ6" .

